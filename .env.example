# Settings NSQ reads from environment variables. All are optional.
# This file is only a list: the code does not load it. Set the ones you need in your
# terminal before running, e.g. PowerShell:  $env:NSQ_REQUEST_DELAY = "5"
#                                  Mac/Linux:  export NSQ_REQUEST_DELAY=5
# Never put a real key in this file or anywhere in the repo.

# Seconds to wait between requests to CDSCO (default 3, minimum 1).
NSQ_REQUEST_DELAY=3

# Browser-like user agent, only if CDSCO answers 403 (default: nsq-tracker/0.1 ...).
NSQ_USER_AGENT=

# Use a different data folder (default: data/).
NSQ_DATA_DIR=

# Only for `python -m nsq parse --llm` (optional LLM fallback for scanned pages).
ANTHROPIC_API_KEY=
NSQ_LLM_MODEL=claude-haiku-5-5

# The online dashboard needs NO secrets: it only reads the public database in site_data/.
